# Copy this file to .env (local dev) and fill in real values.
# For Docker Compose deployment, set these in a .env file next to docker-compose.yml instead.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://mess_user:change_me@localhost:5432/mess_manager?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_to_a_long_random_string"
NEXTAUTH_URL="http://localhost:3000"

# Currency symbol shown throughout the UI
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Used only by prisma/seed.ts to create the first admin account.
# Change the password immediately after first login.
SEED_ADMIN_NAME="Sk Moni"
SEED_ADMIN_EMAIL="skmoni@example.com"
SEED_ADMIN_PASSWORD="change_me_immediately"

SEED_SECOND_USER_NAME="Taufiq Uddin"
SEED_SECOND_USER_EMAIL="taufiq@example.com"
SEED_SECOND_USER_PASSWORD="change_me_immediately"

# Postgres container credentials (docker-compose only)
POSTGRES_USER="mess_user"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="mess_manager"
